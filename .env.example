# GitHub API Token (get from https://github.com/settings/tokens)
# Required permissions: Public repositories (read-only)
GITHUB_TOKEN=

# Optional: Site URL for SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Copy this file to .env.local. All AI variables are server-only.
# Your endpoint must support structured JSON output in one of these formats.
# AI_PROVIDER: compatible (default), openai, or ollama
AI_PROVIDER=compatible
# Optional public display name for the service receiving user questions.
AI_PROVIDER_NAME=
# AI_API_FORMAT: chat (chat completions) or responses
AI_API_FORMAT=chat
# Configure either a base URL (suffix is added) or an exact endpoint.
AI_BASE_URL=
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=
# Optional Responses settings. Codex's "fast" tier maps to API "priority".
AI_REASONING_EFFORT=
AI_SERVICE_TIER=
# http (default) or codex, for providers that support the official Codex client.
# Codex transport requires Responses and verified codex-cli 0.166.0-alpha.5.1.
# Set the absolute executable path on the server; no personal config is loaded.
AI_TRANSPORT=http
AI_CODEX_PATH=
# Optional deployment origin, e.g. https://appforge.example.com (no trailing slash)
APPFORGE_ORIGIN=
# Applies to analysis requests per server instance, including cached reports.
AI_HOURLY_REQUEST_LIMIT=60
# Optional stable signing secret (32+ random characters) for GitHub search pagination.
# Set the same value across server instances; otherwise cursors reset on restart.
AI_SEARCH_CURSOR_SECRET=
